# 复制本文件为 .env 后填入真实密钥（.env 已被 gitignore，不会进版本库）。
# application.yml 通过 spring.config.import: optional:file:./.env[.properties] 读取。

# 对话模型：DeepSeek（OpenAI 兼容协议）
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 向量化模型：智谱 embedding-2（同时也用于「智谱 GLM」对话模型）
ZHIPU_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.xxxxxxxxxxxxxxxx
